[Unit]
Description=AImaster service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aimaster
Group=aimaster
SupplementaryGroups=audio dialout
WorkingDirectory=/var/lib/aimaster
ExecStart=/usr/lib/aimaster/AImaster
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/aimaster /var/log/aimaster

[Install]
WantedBy=multi-user.target
